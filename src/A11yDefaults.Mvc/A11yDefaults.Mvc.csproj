<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>A11yDefaults.Mvc</PackageId>
    <VersionPrefix>1.1.0</VersionPrefix>
    <Description>Accessibility-first Tag Helpers and CSS defaults for ASP.NET Core MVC.</Description>
    <PackageTags>accessibility;a11y;aspnetcore;mvc;razor;wcag</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tlexricdixon/A11yDefaults</PackageProjectUrl>
    <Authors>a11y ronin</Authors>
    <Copyright>Copyright (c) 2026 tlex.dev</Copyright>
    <RepositoryUrl>https://github.com/tlexricdixon/A11yDefaults.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Improves MVC-generated anchor support, skip-link and focus-ring defaults, configurable link hint visibility, and package documentation.</PackageReleaseNotes>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Summary>Accessibility-first Tag Helpers and self-contained CSS utilities for ASP.NET Core MVC and Razor Pages.</Summary>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
