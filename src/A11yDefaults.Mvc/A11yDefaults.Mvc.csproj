<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>A11yDefaults.Mvc</PackageId>
    <Version>1.0.0</Version>
    <Description>Accessibility-first Tag Helpers and CSS defaults for ASP.NET Core MVC.</Description>
    <PackageTags>accessibility;a11y;aspnetcore;mvc;razor;wcag</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tlexricdixon/A11yDefaults</PackageProjectUrl>
    <PackageReleaseNotes>Initial release with accessible target-size defaults for anchors, buttons, and button-like inputs; safer target=_blank links; contextual link hints; and bundled CSS utilities.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>a11y ronin</Authors>
    <Copyright>Copyright (c) 2026 tlex.dev</Copyright>
    <RepositoryUrl>https://github.com/tlexricdixon/A11yDefaults.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
