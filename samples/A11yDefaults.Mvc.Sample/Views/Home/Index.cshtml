@{
    ViewData["Title"] = "Generic Government Agency";
}

<section class="agency-hero" aria-labelledby="page-title">
    <div>
        <p class="agency-hero__eyebrow">Public services and safety information</p>
        <h1 id="page-title">Generic Government Agency</h1>
        <p class="agency-hero__lede">
            Access records, public safety resources, licensing services, and agency updates from one central location.
        </p>
    </div>
    <div class="agency-hero__panel" aria-label="Service status">
        <span class="agency-hero__status">Online services available</span>
        <strong>Current response window</strong>
        <p>Most online requests receive an initial response within two business days.</p>
    </div>
</section>

<section class="quick-actions" aria-labelledby="quick-actions-title">
    <div class="section-heading">
        <p>Popular services</p>
        <h2 id="quick-actions-title">How can we help?</h2>
    </div>
    <div class="quick-actions__grid">
        <a11y-button a11y-variant="primary" a11y-size="lg" a11y-hit-target="@A11yTargetSize.Enhanced" onclick="window.location.hash='#records'">
            Request a record
        </a11y-button>
        <a11y-button a11y-variant="primary" a11y-size="lg" a11y-hit-target="@A11yTargetSize.Enhanced" onclick="window.location.hash='#safety'">
            Report a safety concern
        </a11y-button>
        <a11y-button a11y-variant="primary" a11y-size="lg" a11y-hit-target="@A11yTargetSize.Enhanced" onclick="window.location.hash='#services'">
            Renew a permit
        </a11y-button>
        <a11y-button a11y-variant="primary" a11y-size="lg" a11y-hit-target="@A11yTargetSize.Enhanced" onclick="window.location.hash='#contact'">
            Contact a district office
        </a11y-button>
    </div>
</section>

<section class="agency-alert" aria-labelledby="alert-title">
    <div>
        <p>Agency notice</p>
        <h2 id="alert-title">Service centers are open with expanded online options</h2>
    </div>
    <a href="https://www.w3.org/WAI/"
       target="_blank"
       a11y-hit-target="@A11yTargetSize.Minimum"
       a11y-hint-visibility="@A11yLinkHintVisibility.Visible">
        Accessibility resources
    </a>
</section>

<section class="service-sections" aria-label="Agency service areas">
    <article class="service-card" id="services">
        <span class="service-card__label">Services</span>
        <h2>Licenses and permits</h2>
        <p>Start, renew, or update agency-issued licenses and permits through guided online services.</p>
        <a11y-button a11y-variant="primary" a11y-hit-target="@A11yTargetSize.Minimum">Start request</a11y-button>
        <p>Request public records, download forms, and check the status of submitted requests.</p>
            <a class="service-card__action" href="/docs/accessibility-checklist.pdf" download a11y-hit-target="@A11yTargetSize.Minimum">
            Download form
        </a>
    </article>

    <article class="service-card" id="safety">
        <span class="service-card__label">Safety</span>
        <h2>Public safety updates</h2>
        <p>Find current advisories, preparedness resources, and regional safety information.</p>
        <a11y-button a11y-variant="primary" a11y-hit-target="@A11yTargetSize.Minimum">View advisories</a11y-button>
    </article>

    <article class="service-card" id="contact">
        <span class="service-card__label">Contact</span>
        <h2>District offices</h2>
        <p>Locate offices, hours, and contact channels for agency services across the state.</p>
        <a href="mailto:info@example.gov" a11y-hit-target="@A11yTargetSize.Minimum">
            Email the agency
        </a>
    </article>
</section>

<section class="skip-demo" aria-labelledby="skip-demo-title">
    <div>
        <p>Accessibility default in this sample</p>
        <h2 id="skip-demo-title">The page header includes a skip link</h2>
    </div>
    <code>&lt;a a11y-skip-link a11y-skip-target="content"&gt;&lt;/a&gt;</code>
</section>

<section class="button-demo" aria-labelledby="button-demo-title">
    <div>
        <p>Button components</p>
        <h2 id="button-demo-title">A11y Button Showcase</h2>
    </div>

    <div class="button-demo__group">
        <h3>Variants</h3>
        <div class="button-demo__row">
            <a11y-button a11y-variant="primary">Primary</a11y-button>
            <a11y-button a11y-variant="secondary">Secondary</a11y-button>
            <a11y-button a11y-variant="success">Success</a11y-button>
            <a11y-button a11y-variant="danger">Danger</a11y-button>
            <a11y-button a11y-variant="warning">Warning</a11y-button>
            <a11y-button a11y-variant="info">Info</a11y-button>
        </div>
    </div>

    <div class="button-demo__group">
        <h3>Outline Variants</h3>
        <div class="button-demo__row">
            <a11y-button a11y-variant="primary" a11y-outline>Primary</a11y-button>
            <a11y-button a11y-variant="secondary" a11y-outline>Secondary</a11y-button>
            <a11y-button a11y-variant="success" a11y-outline>Success</a11y-button>
            <a11y-button a11y-variant="danger" a11y-outline>Danger</a11y-button>
        </div>
    </div>

    <div class="button-demo__group">
        <h3>Sizes</h3>
        <div class="button-demo__row">
            <a11y-button a11y-size="sm">Small button</a11y-button>
            <a11y-button>Standard button</a11y-button>
            <a11y-button a11y-size="lg">Large button</a11y-button>
        </div>
    </div>

    <div class="button-demo__group">
        <h3>States</h3>
        <div class="button-demo__row">
            <a11y-button>Default</a11y-button>
            <a11y-button a11y-disabled>Disabled</a11y-button>
            <a11y-button a11y-loading a11y-loading-text="Submitting...">Submit Form</a11y-button>
        </div>
    </div>

    <div class="button-demo__group">
        <h3>Icon-Only with Label</h3>
        <div class="button-demo__row">
            <a11y-button a11y-label="Close dialog">×</a11y-button>
            <a11y-button a11y-label="Search">🔍</a11y-button>
            <a11y-button a11y-label="Settings">⚙️</a11y-button>
        </div>
    </div>

    <div class="button-demo__group">
        <h3>Hit Target Sizing</h3>
        <div class="button-demo__row">
            <a11y-button a11y-hit-target="@A11yTargetSize.Minimum">Min</a11y-button>
            <a11y-button a11y-hit-target="@A11yTargetSize.Enhanced">Enh</a11y-button>
        </div>
    </div>

    <div class="button-demo__group">
        <h3>Combined Features</h3>
        <div class="button-demo__row">
            <a11y-button a11y-variant="success" a11y-size="lg" a11y-hit-target="@A11yTargetSize.Enhanced">
                Save Changes
            </a11y-button>
            <a11y-button a11y-variant="danger" a11y-outline a11y-size="sm">
                Cancel
            </a11y-button>
            <a11y-button a11y-variant="primary" a11y-label="Download report">📥</a11y-button>
        </div>
    </div>
</section>

<style>
    .agency-hero {
        align-items: stretch;
        background: #eef4f7;
        border-block-end: 6px solid #b9d7ea;
        display: grid;
        gap: 24px;
        grid-template-columns: minmax(0, 1fr);
        margin-inline: calc(50% - 50vw);
        padding: 40px max(24px, calc((100vw - 1100px) / 2)) 44px;
    }

    @@media (min-width: 800px) {
        .agency-hero {
            grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
        }
    }

    .agency-hero__eyebrow,
    .section-heading p,
    .agency-alert p,
    .skip-demo p {
        color: #425466;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        margin: 0 0 8px;
        text-transform: uppercase;
    }

    .agency-hero h1 {
        color: #13294b;
        font-size: clamp(2.25rem, 4vw, 4rem);
        line-height: 1.05;
        margin: 0;
        max-width: 13ch;
    }

    .agency-hero__lede {
        color: #263b4c;
        font-size: 1.15rem;
        line-height: 1.55;
        margin: 18px 0 0;
        max-width: 60ch;
    }

    .agency-hero__panel {
        background: #ffffff;
        border: 1px solid #bfd1df;
        border-radius: 8px;
        display: grid;
        gap: 10px;
        padding: 24px;
    }

    .agency-hero__panel strong {
        color: #13294b;
        font-size: 1.15rem;
    }

    .agency-hero__panel p {
        color: #425466;
        margin: 0;
    }

    .agency-hero__status {
        background: #d7f0df;
        border: 1px solid #78bd8c;
        border-radius: 999px;
        color: #214f2b;
        display: inline-flex;
        font-size: 0.85rem;
        font-weight: 700;
        inline-size: fit-content;
        padding: 0.35rem 0.65rem;
    }

    .quick-actions,
    .agency-alert,
    .service-sections,
    .skip-demo,
    .button-demo {
        margin-top: 32px;
    }

    .section-heading h2,
    .agency-alert h2,
    .skip-demo h2,
    .button-demo h2 {
        color: #13294b;
        font-size: 1.5rem;
        margin: 0;
    }

    .quick-actions__grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        margin-top: 18px;
    }

    .agency-alert {
        align-items: center;
        background: #fff5d6;
        border-inline-start: 8px solid #dca900;
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: space-between;
        padding: 22px 24px;
    }

    .agency-alert a {
        color: #164a7c;
        text-decoration: none;
        font-weight: 700;
    }

    .agency-alert a:hover {
        text-decoration: underline;
    }

    .service-sections {
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }

    .service-card {
        border: 1px solid #c7d4df;
        border-radius: 8px;
        display: grid;
        gap: 12px;
        padding: 22px;
    }

    .service-card__label {
        color: #5c6670;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .service-card h2 {
        color: #13294b;
        font-size: 1.2rem;
        margin: 0;
    }

    .service-card p {
        color: #425466;
        margin: 0;
    }

    .service-card .a11y-btn,
    .service-card a {
        align-self: end;
        margin-top: 8px;
    }

    .skip-demo {
        align-items: center;
        background: #f3f7fa;
        border: 1px solid #c7d4df;
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: space-between;
        padding: 22px 24px;
    }

    code {
        background: #ffffff;
        border: 1px solid #c7d4df;
        border-radius: 4px;
        color: #13294b;
        font-size: 0.95rem;
        max-inline-size: 100%;
        overflow-wrap: anywhere;
        padding: 0.5rem 0.65rem;
    }

    .button-demo h3 {
        color: #13294b;
        font-size: 1.1rem;
        margin-top: 24px;
        margin-bottom: 12px;
    }

    .button-demo__row {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .button-demo__group {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }
</style>
