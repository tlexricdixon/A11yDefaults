<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A11yDefaults.Mvc</title>
    <!-- Bootstrap loads first -->
    <link href="~/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <!-- Your custom site styles load last -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- A11yDefaults components use their own a11y-* classes and do not depend on Bootstrap button classes. -->
    <link rel="stylesheet" href="~/_content/A11yDefaults.Mvc/a11y-defaults.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/A11yDefaults.Mvc.Sample.styles.css" asp-append-version="true" />
</head>
<body>
    <a a11y-skip-link a11y-skip-target="content"></a>
    <header class="agency-header">
        <div class="official-banner">
            <div class="official-banner__inner">
                <span aria-hidden="true">US</span>
                <p>An official website of a generic government organization</p>
            </div>
        </div>

        <div class="agency-masthead">
            <div class="agency-masthead__inner">
                <a class="agency-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="agency-brand__seal" aria-hidden="true">GGA</span>
                    <span>
                        <span class="agency-brand__kicker">State of Accessibility</span>
                        <span class="agency-brand__name">Generic Government Agency</span>
                    </span>
                </a>
                <form class="agency-search" role="search">
                    <label class="a11y-sr-only" for="agency-search">Search Generic Government Agency</label>
                    <input id="agency-search" name="q" type="search" placeholder="Search" />
                    <button type="submit" a11y-hit-target="@A11yTargetSize.Minimum">Search</button>
                </form>
            </div>
        </div>

        <nav class="site-nav" aria-label="Primary navigation">
            <div class="site-nav__inner">
                <a asp-area="" asp-controller="Home" asp-action="Index" a11y-hit-target="@A11yTargetSize.Minimum">Home</a>
                <a href="#services" a11y-hit-target="@A11yTargetSize.Minimum">Services</a>
                <a href="#records" a11y-hit-target="@A11yTargetSize.Minimum">Records</a>
                <a href="#safety" a11y-hit-target="@A11yTargetSize.Minimum">Public Safety</a>
                <a href="#contact" a11y-hit-target="@A11yTargetSize.Minimum">Contact</a>
                <a href="https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html" target="_blank" a11y-hit-target="@A11yTargetSize.Minimum">
                    WCAG Guidance
                </a>
            </div>
        </nav>
    </header>
    <div class="page-shell">
        <main id="content" role="main" class="page-shell__content" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <span>&copy; 2026 Generic Government Agency</span>
            <a href="https://www.w3.org/WAI/" target="_blank">
                Accessibility guidance
            </a>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/bootstrap/js/bootstrap.bundle.js"></script>
</body>
</html>
