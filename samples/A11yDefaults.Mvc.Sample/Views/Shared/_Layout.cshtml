<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A11yDefaults.Mvc</title>
    <link rel="stylesheet" href="~/_content/A11yDefaults.Mvc/a11y-defaults.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/A11yDefaults.Mvc.Sample.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="site-nav">
            <div class="site-nav__inner">
                <a class="site-nav__brand" asp-area="" asp-controller="Home" asp-action="Index">A11yDefaults.Mvc</a>
                <div class="site-nav__links">
                    <a asp-area="" asp-controller="Home" asp-action="Index">Sample</a>
                    <a href="https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html" target="_blank">
                        WCAG target size
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <div class="page-shell">
        <main role="main" class="page-shell__content">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <span>&copy; 2026 A11yDefaults.Mvc</span>
            <a href="https://www.w3.org/WAI/" target="_blank" a11y-sr-only-hint>
                W3C WAI
            </a>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
